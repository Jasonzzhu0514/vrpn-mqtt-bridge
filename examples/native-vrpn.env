# Native VRPN reader example. The bridge reads tracker0 and publishes MQTT topics.
VRPN_COMPAT=native-vrpn
VRPN_HOST=127.0.0.1
VRPN_PORT=3883
VRPN_TRACKER=tracker0
VRPN_SOURCE=native
VRPN_NATIVE_READER_BIN=vrpn_pose_reader

VRPN_MQTT_HOST=localhost
VRPN_MQTT_PORT=1883
VRPN_MQTT_USERNAME=
VRPN_MQTT_PASSWORD=

VRPN_MQTT_POSE_TOPIC=vrpn/pose
VRPN_MQTT_YAW_TOPIC=vrpn/yaw
VRPN_MQTT_STATUS_TOPIC=vrpn/status
VRPN_MQTT_FREQUENCY_TOPIC=vrpn/frequency

VRPN_MAX_MQTT_RATE=30
VRPN_DISPLAY_RATE=20
VRPN_STATUS_INTERVAL_SEC=1
VRPN_TIMEOUT_SEC=5
