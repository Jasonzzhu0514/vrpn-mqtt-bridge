# Legacy SLAM-style topic example. Keep this outside the package code so the
# bridge remains reusable in other environments.
VRPN_HOST=127.0.0.1
VRPN_PORT=3883
VRPN_TRACKER=tracker
VRPN_SOURCE=cli

VRPN_MQTT_HOST=localhost
VRPN_MQTT_PORT=1883
VRPN_MQTT_USERNAME=
VRPN_MQTT_PASSWORD=

VRPN_MQTT_POSE_TOPIC=slam/position
VRPN_MQTT_YAW_TOPIC=slam/yaw
VRPN_MQTT_STATUS_TOPIC=slam/status
VRPN_MQTT_FREQUENCY_TOPIC=slam/frequency

VRPN_MAX_MQTT_RATE=30
VRPN_DISPLAY_RATE=60
VRPN_STATUS_INTERVAL_SEC=1
VRPN_TIMEOUT_SEC=5
