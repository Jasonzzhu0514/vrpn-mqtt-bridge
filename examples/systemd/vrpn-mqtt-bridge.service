[Unit]
Description=VRPN to MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/vrpn-mqtt-bridge/vrpn-mqtt-bridge.env
ExecStart=%h/.local/opt/vrpn-mqtt-bridge/.venv/bin/vrpn-mqtt-bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
