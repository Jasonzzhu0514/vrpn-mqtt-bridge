# Generic defaults. Copy to .env and adjust for your deployment.
VRPN_HOST=127.0.0.1
VRPN_PORT=3883
VRPN_TRACKER=tracker
VRPN_SOURCE=auto

VRPN_MQTT_HOST=localhost
VRPN_MQTT_PORT=1883
VRPN_MQTT_USERNAME=
VRPN_MQTT_PASSWORD=

VRPN_MQTT_POSE_TOPIC=vrpn/pose
VRPN_MQTT_YAW_TOPIC=vrpn/yaw
VRPN_MQTT_STATUS_TOPIC=vrpn/status
VRPN_MQTT_FREQUENCY_TOPIC=vrpn/frequency

VRPN_MAX_MQTT_RATE=30
VRPN_DISPLAY_RATE=10
VRPN_STATUS_INTERVAL_SEC=1
VRPN_TIMEOUT_SEC=5
VRPN_Z_OFFSET=0
VRPN_INVERT_YAW=false
